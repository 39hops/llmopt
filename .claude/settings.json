{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python .claude/hooks/wsl_guard.py",
            "timeout": 15,
            "statusMessage": "Classifying remote wsl.sh payload"
          },
          {
            "type": "command",
            "command": ".venv/bin/python .claude/hooks/pytest_gate_guard.py",
            "timeout": 10,
            "statusMessage": "Checking pytest-gated commit shape"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python .claude/hooks/codemap_guard.py",
            "timeout": 15,
            "statusMessage": "Checking CODEMAP class"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */docs/RESULTS.md) .venv/bin/python scripts/gen_results_index.py 2>/dev/null; .venv/bin/python .claude/hooks/findings_headroom.py;; */scratch/*.py|*/scripts/*.py) .venv/bin/python scripts/gen_index.py 2>/dev/null; echo 'INDEX regenerated. If this file is NEW: commit it, then rerun gen_codemap.py (tracked files only) or the suite goes red.';; esac; } || true",
            "timeout": 60,
            "statusMessage": "Regenerating results index"
          }
        ]
      }
    ]
  }
}