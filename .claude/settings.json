{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python .claude/hooks/wsl_guard.py",
            "timeout": 15,
            "statusMessage": "Classifying remote wsl.sh payload"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */docs/RESULTS.md) .venv/bin/python scripts/gen_results_index.py;; esac; } 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Regenerating results index"
          }
        ]
      }
    ]
  }
}
